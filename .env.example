# ==============================================================================
# Protein Prediction Platform - Root Environment Configuration
# ==============================================================================
# Copy this file to .env and update with your actual values
# NEVER commit .env file to version control!
#
# This is the root .env file for Docker Compose and scripts
# Backend and frontend have their own .env files in their directories
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
APP_ENV=development  # development, staging, production
DEBUG=true  # Set to false in production

# ------------------------------------------------------------------------------
# Security Configuration (CRITICAL - CHANGE IN PRODUCTION!)
# ------------------------------------------------------------------------------
# Generate a secure random key for JWT signing
# Python: python -c "import secrets; print(secrets.token_urlsafe(32))"
# OpenSSL: openssl rand -base64 32
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-KEY-IN-PRODUCTION

# ------------------------------------------------------------------------------
# JWT Authentication Configuration (NEW - v1.0.0)
# ------------------------------------------------------------------------------
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
SESSION_TTL_SECONDS=1800  # 30 minutes

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# SQLite (default, for development)
# DATABASE_URL=sqlite:///./pp_database.db

# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/pp_db

# PostgreSQL for Docker
# DATABASE_URL=postgresql://pp_user:pp_password@postgres:5432/pp_db

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
# Local Redis
REDIS_URL=redis://localhost:6379/0

# Docker Redis
# REDIS_URL=redis://redis:6379/0

# Redis for sessions (separate database recommended)
# REDIS_SESSION_URL=redis://localhost:6379/1

# Redis with password (production)
# REDIS_URL=redis://:your-redis-password@localhost:6379/0

REDIS_MAX_CONNECTIONS=50

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Worker configuration
WORKERS=1
WORKER_CLASS=uvicorn.workers.UvicornWorker

# ------------------------------------------------------------------------------
# CORS Configuration
# ------------------------------------------------------------------------------
# Development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Production
# CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

CORS_ALLOW_CREDENTIALS=true

# ------------------------------------------------------------------------------
# Security Headers & Protection
# ------------------------------------------------------------------------------
ENABLE_CSRF=true
ENABLE_HSTS=false  # Only enable with HTTPS in production
HSTS_MAX_AGE=31536000

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_REGISTER=5
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REFRESH=20
RATE_LIMIT_API=60

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console
# LOG_FILE=./logs/app.log

# ------------------------------------------------------------------------------
# PP System Integration
# ------------------------------------------------------------------------------
PP_RESULTS_DIR=./results
PP_CHECKPOINTS_DIR=./checkpoints
PP_PDB_CACHE_DIR=./pdb_cache
PP_VISUALIZATION_OUTPUT_DIR=./visualization_output

PP_DEFAULT_ITERATIONS=1000
PP_DEFAULT_AGENTS=10
PP_MAX_SEQUENCE_LENGTH=1000

# ------------------------------------------------------------------------------
# Celery Configuration
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300

# ------------------------------------------------------------------------------
# Docker Configuration
# ------------------------------------------------------------------------------
# PostgreSQL (Docker)
POSTGRES_USER=pp_user
POSTGRES_PASSWORD=change-this-in-production
POSTGRES_DB=pp_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (Docker)
REDIS_HOST=redis
REDIS_PORT=6379

# Container names
CONTAINER_PREFIX=pp

# ------------------------------------------------------------------------------
# External Services (Optional)
# ------------------------------------------------------------------------------
# OpenAI API (for AI features)
# OPENAI_API_KEY=your-openai-key

# SendGrid (for email notifications)
# SENDGRID_API_KEY=your-sendgrid-key
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Sentry (for error tracking)
# SENTRY_DSN=your-sentry-dsn

# ------------------------------------------------------------------------------
# Email Configuration (Optional)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# ------------------------------------------------------------------------------
# Development/Debug Settings
# ------------------------------------------------------------------------------
SQL_ECHO=false
SHOW_ERROR_DETAILS=true
RELOAD=true

# ------------------------------------------------------------------------------
# Production Checklist
# ------------------------------------------------------------------------------
# Before deploying to production, ensure:
# [ ] SECRET_KEY is changed to a secure random value
# [ ] APP_ENV=production, DEBUG=false
# [ ] ENABLE_HSTS=true (with HTTPS)
# [ ] CORS_ORIGINS restricted to your domain
# [ ] All passwords changed (POSTGRES_PASSWORD, Redis, etc.)
# [ ] JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15 (shorter in production)
# [ ] LOG_LEVEL=WARNING or ERROR
# [ ] SHOW_ERROR_DETAILS=false
# [ ] External services configured with production keys
# [ ] Database backups configured
# [ ] SSL/TLS certificates installed
# ==============================================================================