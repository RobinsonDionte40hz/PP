# Production Environment Configuration
# Copy this file to .env.production and update values

# ============================================================================
# Application Settings
# ============================================================================

# Environment mode
ENVIRONMENT=production

# Secret key for JWT and sessions (CHANGE THIS!)
SECRET_KEY=change-me-to-a-random-64-character-string-in-production

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL
POSTGRES_DB=pp_production
POSTGRES_USER=pp_user
POSTGRES_PASSWORD=change-me-to-strong-password

# Full database URL (auto-constructed in docker-compose)
DATABASE_URL=postgresql://pp_user:change-me-to-strong-password@postgres:5432/pp_production

# ============================================================================
# Redis Configuration
# ============================================================================

REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=  # Optional: Set for additional security

# ============================================================================
# Celery Configuration
# ============================================================================

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False
CELERY_WORKER_CONCURRENCY=4

# ============================================================================
# FastAPI Settings
# ============================================================================

# API settings
API_V1_PREFIX=/api
API_TITLE=PP Protein Prediction API
API_VERSION=1.0.0

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Max upload size (in MB)
MAX_UPLOAD_SIZE_MB=50

# ============================================================================
# Frontend Configuration
# ============================================================================

# API URL for frontend (external URL)
REACT_APP_API_URL=https://yourdomain.com/api
REACT_APP_WS_URL=wss://yourdomain.com

# ============================================================================
# Prediction Settings
# ============================================================================

# Default prediction parameters
DEFAULT_ITERATIONS=5000
DEFAULT_AGENTS=10
DEFAULT_DIVERSITY=balanced

# Maximum allowed values
MAX_ITERATIONS=50000
MAX_AGENTS=100
MAX_SEQUENCE_LENGTH=1000

# ============================================================================
# File Storage
# ============================================================================

# Directories for results and caches
CHECKPOINT_DIR=/app/checkpoints
VISUALIZATION_DIR=/app/visualization_output
PDB_CACHE_DIR=/app/pdb_cache
RESULTS_DIR=/app/results

# Cleanup settings (days)
CLEANUP_CHECKPOINTS_AFTER_DAYS=30
CLEANUP_RESULTS_AFTER_DAYS=90

# ============================================================================
# Monitoring (Optional)
# ============================================================================

# Prometheus
PROMETHEUS_ENABLED=false

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-to-strong-password

# ============================================================================
# Email Notifications (Optional)
# ============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# ============================================================================
# Security
# ============================================================================

# Enable authentication
ENABLE_AUTH=true

# JWT settings
JWT_SECRET_KEY=change-me-to-another-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# HTTPS enforcement
FORCE_HTTPS=true

# ============================================================================
# Performance
# ============================================================================

# Worker process settings
BACKEND_WORKERS=4
BACKEND_THREADS=2

# Database connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis connection pool
REDIS_MAX_CONNECTIONS=50

# ============================================================================
# Backup Configuration
# ============================================================================

# Backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/backups

# S3 backup (optional)
S3_BACKUP_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=us-east-1

# ============================================================================
# Development Overrides (Remove in production!)
# ============================================================================

# DEBUG=False  # Never set to True in production!
# TESTING=False
