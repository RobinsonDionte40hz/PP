# ==============================================================================
# Protein Prediction Platform - Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and update with your actual values
# NEVER commit .env file to version control!
#
# Quick Start:
#   1. Copy: cp .env.example .env
#   2. Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
#   3. Update values below
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
APP_ENV=development  # development, staging, production
DEBUG=true  # Set to false in production

# ------------------------------------------------------------------------------
# Security Configuration (CRITICAL - CHANGE IN PRODUCTION!)
# ------------------------------------------------------------------------------
# Generate a secure random key for JWT signing
# Python: python -c "import secrets; print(secrets.token_urlsafe(32))"
# OpenSSL: openssl rand -base64 32
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-KEY-IN-PRODUCTION

# ------------------------------------------------------------------------------
# JWT Authentication Configuration (NEW - v1.0.0)
# ------------------------------------------------------------------------------
# Access token lifetime (in minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifetime (in days)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# JWT signing algorithm (HS256 recommended)
JWT_ALGORITHM=HS256

# Session TTL in Redis (in seconds) - should match or exceed access token TTL
SESSION_TTL_SECONDS=1800  # 30 minutes

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# SQLite (default, for development)
DATABASE_URL=sqlite:///./pp_database.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/pp_db

# PostgreSQL with connection pooling
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/pp_db?pool_size=10&max_overflow=20

# ------------------------------------------------------------------------------
# Redis Configuration (REQUIRED for authentication & Celery)
# ------------------------------------------------------------------------------
# Redis for Celery task queue (database 0)
REDIS_URL=redis://localhost:6379/0

# Redis for authentication sessions (database 1, recommended)
# Uncomment to use separate database for sessions
# REDIS_SESSION_URL=redis://localhost:6379/1

# Redis with password (recommended for production)
# REDIS_URL=redis://:your-redis-password@localhost:6379/0

# Redis connection pool settings
REDIS_MAX_CONNECTIONS=50

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Number of worker processes (use CPU count in production)
WORKERS=1

# Worker class (uvicorn.workers.UvicornWorker for async)
WORKER_CLASS=uvicorn.workers.UvicornWorker

# ------------------------------------------------------------------------------
# CORS Configuration
# ------------------------------------------------------------------------------
# Development: Allow local frontend ports
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Production: Restrict to your domain(s)
# CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# Allow credentials (cookies, auth headers)
CORS_ALLOW_CREDENTIALS=true

# ------------------------------------------------------------------------------
# Security Headers & Protection
# ------------------------------------------------------------------------------
# Enable CSRF protection (recommended: true)
ENABLE_CSRF=true

# Enable HSTS (HTTP Strict Transport Security)
# Only enable in production with HTTPS!
ENABLE_HSTS=false

# HSTS max age in seconds (1 year = 31536000)
HSTS_MAX_AGE=31536000

# ------------------------------------------------------------------------------
# Rate Limiting Configuration
# ------------------------------------------------------------------------------
# Registration rate limit (requests per hour per IP)
RATE_LIMIT_REGISTER=5

# Login rate limit (requests per 15 minutes per IP)
RATE_LIMIT_LOGIN=10

# Token refresh rate limit (requests per hour per user)
RATE_LIMIT_REFRESH=20

# General API rate limit (requests per minute per user)
RATE_LIMIT_API=60

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Log file path (optional)
# LOG_FILE=./logs/backend.log

# Log format (json for production, console for development)
LOG_FORMAT=console  # console, json

# ------------------------------------------------------------------------------
# PP System Integration
# ------------------------------------------------------------------------------
PP_RESULTS_DIR=./results
PP_CHECKPOINTS_DIR=./checkpoints
PP_PDB_CACHE_DIR=./pdb_cache
PP_VISUALIZATION_OUTPUT_DIR=./visualization_output

# PP System configuration
PP_DEFAULT_ITERATIONS=1000
PP_DEFAULT_AGENTS=10
PP_MAX_SEQUENCE_LENGTH=1000

# ------------------------------------------------------------------------------
# Celery Configuration
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Celery task time limits (in seconds)
CELERY_TASK_TIME_LIMIT=3600  # 1 hour
CELERY_TASK_SOFT_TIME_LIMIT=3300  # 55 minutes

# ------------------------------------------------------------------------------
# Email Configuration (Optional - for password reset, notifications)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# SendGrid (alternative)
# SENDGRID_API_KEY=your-sendgrid-key

# ------------------------------------------------------------------------------
# External Services (Optional)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=your-openai-key
# SENTRY_DSN=your-sentry-dsn

# ------------------------------------------------------------------------------
# Development/Debug Settings
# ------------------------------------------------------------------------------
# Enable SQL query logging
SQL_ECHO=false

# Enable detailed error pages (disable in production!)
SHOW_ERROR_DETAILS=true

# Reload on code changes (development only)
RELOAD=true

# ------------------------------------------------------------------------------
# Production Checklist
# ------------------------------------------------------------------------------
# Before deploying to production, ensure:
# [ ] SECRET_KEY is changed to a secure random value
# [ ] APP_ENV=production
# [ ] DEBUG=false
# [ ] ENABLE_HSTS=true (with HTTPS)
# [ ] CORS_ORIGINS restricted to your domain
# [ ] Redis has password authentication
# [ ] Database uses strong credentials
# [ ] LOG_LEVEL=WARNING or ERROR
# [ ] SHOW_ERROR_DETAILS=false
# [ ] JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15 (shorter in production)
# [ ] All external services configured with production keys
# ==============================================================================
