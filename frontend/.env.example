# ==============================================================================
# Protein Prediction Platform - Frontend Environment Configuration
# ==============================================================================
# Copy this file to .env and update with your actual values
# All variables must be prefixed with VITE_ to be exposed to the client
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------------------
VITE_ENV=development  # development, staging, production

# ------------------------------------------------------------------------------
# API Configuration
# ------------------------------------------------------------------------------
# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# WebSocket base URL (for real-time updates)
# Note: Use 'ws://' for HTTP and 'wss://' for HTTPS
VITE_WS_BASE_URL=http://localhost:8000

# API timeout (in milliseconds)
VITE_API_TIMEOUT=30000

# ------------------------------------------------------------------------------
# Authentication Configuration (NEW - v1.0.0)
# ------------------------------------------------------------------------------
# Token refresh interval (in milliseconds)
# Should be less than JWT_ACCESS_TOKEN_EXPIRE_MINUTES
VITE_TOKEN_REFRESH_INTERVAL=1500000  # 25 minutes

# Session timeout warning (in milliseconds)
# Show warning before token expires
VITE_SESSION_TIMEOUT_WARNING=300000  # 5 minutes before expiry

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
# Application name (displayed in UI)
VITE_APP_NAME=Protein Prediction Platform

# Application version
VITE_APP_VERSION=1.0.0

# Enable debug mode (shows additional logs in console)
VITE_DEBUG=true

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------
# Enable authentication features
VITE_ENABLE_AUTH=true

# Enable 3D visualization
VITE_ENABLE_3D_VIEWER=true

# Enable campaign management
VITE_ENABLE_CAMPAIGNS=true

# Enable history browser
VITE_ENABLE_HISTORY=true

# ------------------------------------------------------------------------------
# UI Configuration
# ------------------------------------------------------------------------------
# Default theme mode (light, dark, auto)
VITE_DEFAULT_THEME=light

# Maximum file upload size (in bytes)
VITE_MAX_FILE_SIZE=10485760  # 10 MB

# Results per page in history
VITE_RESULTS_PER_PAGE=10

# ------------------------------------------------------------------------------
# Monitoring & Analytics (Optional)
# ------------------------------------------------------------------------------
# Google Analytics tracking ID
# VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Sentry DSN (for error tracking)
# VITE_SENTRY_DSN=https://your-sentry-dsn

# ------------------------------------------------------------------------------
# Production Configuration
# ------------------------------------------------------------------------------
# For production deployment, update the following:
#
# VITE_ENV=production
# VITE_API_BASE_URL=https://api.yourdomain.com
# VITE_WS_BASE_URL=wss://api.yourdomain.com
# VITE_DEBUG=false
#
# And uncomment monitoring services if needed
# ==============================================================================